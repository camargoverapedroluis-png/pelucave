{
  // Cloudflare Worker «pelucave» con assets estáticos: es lo que sirve https://pelucave.com.
  // Workers Builds (conectado a GitHub, rama main) ejecuta `npx wrangler deploy`, que primero corre
  // build.command y después sube solo ./_site (index.html autocontenido + _headers + _redirects),
  // nunca el repositorio. Guía completa: docs/DEPLOY.md.
  "name": "pelucave",
  "compatibility_date": "2026-10-12",
  "build": {
    "command": "node tools/site.mjs"
  },
  "assets": {
    "directory": "./_site",
    // La app enruta por #hash: cualquier ruta desconocida devuelve index.html con 200.
    "not_found_handling": "single-page-application"
  }
}
